{
  "expo": {
    "name": "StickerCam",
    "slug": "stickercam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stickercam",
    "platforms": ["android", "ios"],
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.runterya.sticker",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.runterya.sticker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F8F1E2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F1E2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "StickerCam, sticker yapmak için fotoğraf çekmek üzere kameranı kullanır.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StickerCam, sticker yapmak için galerindeki fotoğraflara erişir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "22b43827-b10e-43e5-b5ad-4eb2898bf88a"
      }
    },
    "owner": "runterya",
    "updates": {
      "url": "https://u.expo.dev/22b43827-b10e-43e5-b5ad-4eb2898bf88a",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
